# Copy to .env and fill in. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Google Drive API Key (simple, recommended for data access)
# Get a free key: https://console.cloud.google.com → APIs & Services → Credentials
# Enable Google Drive API for your project
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Google Drive folder ID containing data files (Freddie Mac, SOMA, etc.)
# Find the folder ID in the URL: https://drive.google.com/drive/folders/{FOLDER_ID}
DATA_FOLDER_ID=your_google_drive_folder_id_here

# Optional: Override the default cache directory for downloaded data
# DATA_CACHE_DIR=./data/cache

# Alternative: If you have a service account JSON file, you can use that instead of API key
# GOOGLE_DRIVE_CREDENTIALS_JSON=./service-account-key.json
